class ContaBancaria:
    def __init__(self,titular):
        self.titular = titular
        self.saldo = 0
    def depositar(self,valor):
        self.saldo += valor
    def sacar(self,valor):
        if valor <= self.saldo:
            self.saldo -= valor
            print(f"Você irá sacar R${valor}.")
        else:
            print(f"Sem saldo{valor}.")
    def __str__(self):
        return f"Titular: {self.titular}, Saldo: R${self.saldo}"
    
titular1 = ContaBancaria("Fernando")
titular1.depositar(10000)
print(titular1)
