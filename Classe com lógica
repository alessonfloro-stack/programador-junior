Classe chamada ContaBancaria com:
#Atributos: titular e saldo
#Método: depositar(valor) — adiciona ao saldo
#Método: sacar(valor) — remove do saldo, mas só se tiver saldo suficiente
#Método: ver_saldo() — exibe o saldo atual

class ContaBancaria:
    def __init__(self, titular):
        self.titular = titular
        self.saldo = 0
    
    def depositar(self, valor):
        self.saldo += valor 

    def sacar(self, valor):

        if valor <= self.saldo:
            self.saldo -= valor
            print(f"Você irá sacar R${valor}.")

        else:
            print(f"Sem saldo {valor}.")
            

    def ver_saldo(self):
        print(f"Você tem na conta R${self.saldo}.")


#CHAMAR:
titular1 = ContaBancaria("Fernando")
titular1.depositar(1000)
titular1.sacar(1)
titular1.ver_saldo()
